{
  "name": "gitrate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/scoring-engine"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "npm run build --workspace @gitrate/scoring-engine && next build",
    "start": "next start",
    "test": "npm run build --workspace @gitrate/scoring-engine && vitest run",
    "lint": "eslint app components lib packages --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@gitrate/scoring-engine": "*",
    "@octokit/rest": "^22.0.0",
    "@tanstack/react-query": "^5.90.2",
    "lucide-react": "^0.545.0",
    "next": "^16.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^5.0.3"
  }
}
